# Copy this file to ".env" and change the secrets. Never commit ".env".
FLASK_ENV=development
SECRET_KEY=change-this-to-a-long-random-string
JWT_SECRET_KEY=change-this-to-another-long-random-string
JWT_EXPIRES_HOURS=8
DATABASE_URL=sqlite:///pharmalims.db
CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=INFO
# Optional: LOG_DIR (default: the logs folder), LOG_MAX_BYTES=5000000, LOG_BACKUP_COUNT=5
PASSWORD_MIN_LENGTH=8

# Passwords for the starter accounts created by "python seed.py" (letters and numbers only)
SEED_ADMIN_PASSWORD=Admin12345
SEED_ANALYST_PASSWORD=Analyst12345
SEED_TECHNICIAN_PASSWORD=Technician12345
